{
    "epochs": 100,
    "batch_size": 4,
    "learning_rate": 0.000999619059278824,
    "shuffle_buffer_size": 500,
    "class_weights": [
        0.1,
        1.0,
        1.0,
        1.0
    ],
    "loss": {
        "alpha": 1.0,
        "smooth": 1e-05,
        "use_base_optimal_weights": true
    },
    "early_stopping": {
        "monitor": "val_mean_iou",
        "mode": "max",
        "patience": 10,
        "restore_best_weights": true,
        "start_from_epoch": 5
    },
    "model_checkpoint": {
        "monitor": "val_mean_iou",
        "mode": "max",
        "save_best_only": true
    },
    "reduce_lr_on_plateau": {
        "monitor": "val_loss",
        "factor": 0.2,
        "patience": 5,
        "min_lr": 1e-07
    },
    "base_model_filename": "unet_optimized_combined_loss.h5",
    "finetuned_model_filename": "unet_finetuned_gold.h5"
}
